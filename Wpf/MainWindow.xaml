<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="720" MinHeight="480" Width="1100" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="16,10,16,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.05*" MinWidth="340"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="0.95*" MinWidth="260"/>
    </Grid.ColumnDefinitions>

    <!-- Left column -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <CheckBox x:Name="chkKeepDhcp" Content="Keep DHCP" IsChecked="True" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
          <CheckBox x:Name="chkGateway" Content="Gateway support" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="lblTitle" Text="IPbind" FontSize="22" FontWeight="Bold"
                   TextAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>

      <TextBlock x:Name="lblSub" Grid.Row="1" Style="{DynamicResource SubText}" Margin="0,2,0,8"
                 Text="Static IP Binder for easily accessing air-gapped equipment spread across multiple IP ranges"/>

      <TextBlock x:Name="lblAdapter" Grid.Row="2" Text="Select your LAN interface below:" Margin="0,0,0,4"/>

      <Grid Grid.Row="3" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="combo" IsEditable="False" MinHeight="24"/>
        <Button x:Name="btnRefresh" Grid.Column="2" Content="Refresh" MinWidth="88" Padding="12,4"/>
      </Grid>

      <CheckBox x:Name="chkAll" Grid.Row="4" Content="Show all adapters (include virtual / cellular / VPN)"
                FontSize="11" Margin="0,0,0,8"/>

      <TextBlock x:Name="lblIPs" Grid.Row="5" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                 Text="IP addresses to bind - one per line, CIDR (e.g. 192.168.1.98/24). No gateway or DNS:"/>

      <Grid x:Name="ipsHost" Grid.Row="6" Margin="0,0,0,8">
        <TextBox x:Name="txtIPs" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                 VerticalContentAlignment="Top"/>
        <Border x:Name="ipsTrack" Width="10" HorizontalAlignment="Right" Background="Transparent">
          <Border x:Name="ipsThumb" Width="6" Height="24" HorizontalAlignment="Center"
                  VerticalAlignment="Top" CornerRadius="3"
                  Background="{DynamicResource ThumbBrush}" Visibility="Collapsed"/>
        </Border>
      </Grid>

      <Grid x:Name="gatewayRow1" Grid.Row="7" Margin="0,0,0,6" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="80"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="80"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="lblGwOn" Text="Use gateway on:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="cboGwIp" Grid.Column="1" IsEditable="False"/>
        <TextBlock x:Name="lblGateway" Grid.Column="3" Text="Gateway:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="txtGateway" Grid.Column="4" MaxLength="15"/>
      </Grid>

      <Grid x:Name="gatewayRow2" Grid.Row="8" Margin="0,0,0,8" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="80"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="80"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="lblDns1" Text="DNS 1:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="txtDns1" Grid.Column="1" MaxLength="15"/>
        <TextBlock x:Name="lblDns2" Grid.Column="3" Text="DNS 2:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="txtDns2" Grid.Column="4" MaxLength="15"/>
      </Grid>

      <Grid Grid.Row="9" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnSaveList" Content="Save List" Padding="8,6"/>
        <Button x:Name="btnRestore" Grid.Column="2" Content="Restore Defaults" Padding="8,6"/>
        <Button x:Name="btnShow" Grid.Column="4" Content="Show Current" Padding="8,6"/>
      </Grid>

      <Grid Grid.Row="10" Margin="0,0,0,8" MinHeight="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnBind" Style="{DynamicResource AccentButton}"
                Background="{DynamicResource AccentApply}" Content="Apply Static IPs"/>
        <Button x:Name="btnDhcp" Grid.Column="2" Style="{DynamicResource AccentButton}"
                Background="{DynamicResource AccentDhcp}" Content="Return to DHCP"/>
      </Grid>

      <Grid Grid.Row="11" MinHeight="38">
        <TextBlock x:Name="lblStatus" Text="Ready." FontWeight="Bold" FontSize="13"
                   TextAlignment="Center" VerticalAlignment="Center"/>
        <Border x:Name="updateBanner" Visibility="Collapsed"
                Background="{DynamicResource BannerBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" Padding="8,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblUpdateBanner" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="btnUpdateNow" Grid.Column="1" Content="Update" MinWidth="88" Margin="8,0,6,0" Padding="8,3"/>
            <Button x:Name="btnUpdateLater" Grid.Column="2" Content="Later" MinWidth="88" Padding="8,3"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Right column -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,6">
        <Button x:Name="btnClear" DockPanel.Dock="Right" Content="Clear" MinWidth="72" Padding="10,3"/>
        <TextBlock Text="Console output:" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid x:Name="consoleHost" Grid.Row="1">
        <RichTextBox x:Name="console" IsReadOnly="True" IsUndoEnabled="False"
                     FontFamily="Consolas" FontSize="12"
                     Background="{DynamicResource ConsoleBgBrush}"
                     Foreground="{DynamicResource ConsoleFgBrush}"
                     BorderBrush="{DynamicResource BorderBrushKey}"
                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                     AcceptsReturn="True"/>
        <Border x:Name="consoleTrack" Width="10" HorizontalAlignment="Right" Background="Transparent">
          <Border x:Name="consoleThumb" Width="6" Height="24" HorizontalAlignment="Center"
                  VerticalAlignment="Top" CornerRadius="3"
                  Background="{DynamicResource ThumbBrush}" Visibility="Collapsed"/>
        </Border>
      </Grid>
      <Button x:Name="btnAbout" Grid.Row="2" Content="About" HorizontalAlignment="Right"
              MinWidth="96" Margin="0,10,0,0" Padding="10,4" FontSize="11"/>
    </Grid>
  </Grid>
</Window>
