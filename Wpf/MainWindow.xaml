<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="980" MinHeight="520" Width="1000" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="16,12,16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Status banner -->
      <Border x:Name="statusBanner" Grid.Row="0" CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,14"
              Background="{DynamicResource BannerNoneBg}" BorderBrush="{DynamicResource BannerNoneBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
            <Ellipse x:Name="bannerIcon" Fill="{DynamicResource BannerNoneAccent}"/>
            <Canvas Width="28" Height="28">
              <Path x:Name="bannerGlyphCheck" Visibility="Collapsed" Stroke="White" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 8,14.5 L 12.2,18.6 L 20.2,9.2"/>
              <Path x:Name="bannerGlyphBang" Visibility="Collapsed" Stroke="White" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 14,8 L 14,16 M 14,19.2 L 14.1,19.2"/>
              <Path x:Name="bannerGlyphX" Visibility="Collapsed" Stroke="White" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 9.5,9.5 L 18.5,18.5 M 18.5,9.5 L 9.5,18.5"/>
              <Path x:Name="bannerGlyphDash" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                    Data="M 9,14 L 19,14"/>
            </Canvas>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="bannerHeadline" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"
                       Text="No interface selected"/>
            <TextBlock x:Name="bannerDetail" FontSize="12" Margin="0,2,0,0" Opacity="0.85" TextWrapping="Wrap"
                       Text="Choose a LAN interface below."/>
          </StackPanel>
          <Button x:Name="btnShow" Grid.Column="2" Content="Show Current" MinWidth="112" MinHeight="32"
                  VerticalAlignment="Center" Padding="12,6"/>
        </Grid>
      </Border>

      <!-- Columns: console is as tall as the whole left column -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" MinWidth="420"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="1*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="leftColumn" Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*" MinHeight="90"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 1. Select interface -->
          <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" MinHeight="28" Margin="0,0,0,8">
              <Border Style="{DynamicResource SectionBadge}">
                <TextBlock Text="1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Select your LAN interface" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="combo" IsEditable="False" MinHeight="28" VerticalAlignment="Center"/>
              <Button x:Name="btnRefresh" Grid.Column="2" Content="Refresh" MinWidth="88" MinHeight="28" Padding="12,4"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="chkAll" Content="Show all adapters (include virtual / cellular / VPN)"
                        FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="chkKeepDhcp" Content="Keep DHCP" IsChecked="True" FontSize="12"
                          Margin="0,0,16,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="chkGateway" Content="Gateway support" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- 2. IP list (+ gateway fields when enabled) -->
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="60"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6" MinHeight="28">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{DynamicResource SectionBadge}">
                <TextBlock Text="2" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="1" Text="IP addresses to bind" FontSize="14" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="lblIPs" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                         Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,0,8,0"
                         Text="One per line, CIDR (e.g. 192.168.1.98/24)"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnSaveList" Content="Save List" Padding="10,4" MinWidth="76"/>
                <Button x:Name="btnRestore" Content="Restore Defaults" Margin="8,0,0,0" Padding="10,4"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="ipsHost" Grid.Row="1">
              <TextBox x:Name="txtIPs" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" FontSize="13"
                       VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                       VerticalContentAlignment="Top"/>
              <Border x:Name="ipsTrack" Width="10" HorizontalAlignment="Right" Background="Transparent">
                <Border x:Name="ipsThumb" Width="6" Height="24" HorizontalAlignment="Center"
                        VerticalAlignment="Top" CornerRadius="3"
                        Background="{DynamicResource ThumbBrush}" Visibility="Collapsed"/>
              </Border>
            </Grid>
            <Grid x:Name="gatewayRow1" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="lblGwOn" Text="Use gateway on" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="cboGwIp" Grid.Column="1" IsEditable="False" MinHeight="26"/>
              <TextBlock x:Name="lblGateway" Grid.Column="3" Text="Gateway" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="txtGateway" Grid.Column="4" MaxLength="15" MinHeight="26"/>
            </Grid>
            <Grid x:Name="gatewayRow2" Grid.Row="3" Margin="0,6,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="lblDns1" Text="DNS 1" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="txtDns1" Grid.Column="1" MaxLength="15" MinHeight="26"/>
              <TextBlock x:Name="lblDns2" Grid.Column="3" Text="DNS 2" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="txtDns2" Grid.Column="4" MaxLength="15" MinHeight="26"/>
            </Grid>
          </Grid>

          <!-- 3. Apply / DHCP -->
          <StackPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" MinHeight="28" Margin="0,0,0,8">
              <Border Style="{DynamicResource SectionBadge}">
                <TextBlock Text="3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Apply or return to DHCP" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid MinHeight="48">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="btnBind" Style="{DynamicResource AccentButton}" MinHeight="48"
                      Background="{DynamicResource AccentApply}" Content="Apply Static IPs"/>
              <Button x:Name="btnDhcp" Grid.Column="2" Style="{DynamicResource AccentButton}" MinHeight="48"
                      Background="{DynamicResource AccentDhcp}" Content="Return to DHCP"/>
            </Grid>
          </StackPanel>
        </Grid>

        <Grid x:Name="rightColumn" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
          </Grid.RowDefinitions>
          <Grid MinHeight="28" Margin="0,0,0,8">
            <TextBlock Text="Console output" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="btnClear" Content="Clear" HorizontalAlignment="Right" MinWidth="72" MinHeight="28" Padding="10,4"/>
          </Grid>
          <Grid x:Name="consoleHost" Grid.Row="1">
            <RichTextBox x:Name="console" AutomationProperties.Name="Console" IsReadOnly="True" IsUndoEnabled="False"
                         FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource ConsoleBgBrush}"
                         Foreground="{DynamicResource ConsoleFgBrush}"
                         BorderBrush="{DynamicResource BorderBrushKey}"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                         AcceptsReturn="True"/>
            <Border x:Name="consoleTrack" Width="10" HorizontalAlignment="Right" Background="Transparent">
              <Border x:Name="consoleThumb" Width="6" Height="24" HorizontalAlignment="Center"
                      VerticalAlignment="Top" CornerRadius="3"
                      Background="{DynamicResource ThumbBrush}" Visibility="Collapsed"/>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- Bottom bar. The update banner sits in this bar and does not cover the console. -->
    <Border Grid.Row="1" Background="{DynamicResource BottomBarBrush}"
            BorderBrush="{DynamicResource BottomBarLine}" BorderThickness="0,1,0,0" Padding="16,8,16,10">
      <Grid MinHeight="34">
        <TextBlock x:Name="lblStatus" Text="Ready." FontWeight="Bold" FontSize="13"
                   VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,110,0"/>
        <Border x:Name="updateBanner" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,110,0"
                Background="Transparent">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblUpdateBanner" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="btnUpdateNow" Grid.Column="1" Content="Update" MinWidth="88" Margin="8,0,6,0" Padding="8,3"/>
            <Button x:Name="btnUpdateLater" Grid.Column="2" Content="Later" MinWidth="72" Padding="8,3"/>
          </Grid>
        </Border>
        <Button x:Name="btnAbout" Content="About" HorizontalAlignment="Right" VerticalAlignment="Center"
                MinWidth="88" Padding="12,4"/>
      </Grid>
    </Border>
  </Grid>
</Window>
